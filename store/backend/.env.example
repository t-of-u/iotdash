# Settings of the iotstore Lambda (set them on the function; run_local.sh reads .env.local).

# JWT signing key (and local download signatures): a long random string
JWT_SECRET_KEY=change-me-to-a-long-random-string

# AWS
AWS_REGION=ap-southeast-1
# DynamoDB tables: iotstore-users, iotstore-projects, iotstore-versions (TABLE_PREFIX changes the prefix)
TABLE_PREFIX=iotstore-
# DYNAMODB_ENDPOINT_URL=http://localhost:8000   # DynamoDB Local; unset = AWS (or moto in run_local.sh)

# Package files: s3 (the Lambda; run_local.sh too, with real credentials) or local (no AWS at all)
STORAGE=s3
S3_BUCKET_NAME=my-store-packages   # yours: bucket names are global
# run_local.sh with STORAGE=s3: the credentials for the bucket (DynamoDB stays in-process)
# AWS_PROFILE=<your profile>
# local storage only:
# LOCAL_STORAGE_DIR=.data/storage
# PUBLIC_BASE_URL=http://192.168.1.10:9310      # how boards on the LAN and the browser reach this runner

CORS_ORIGIN=*
# STORE_NAME=iotstore      # shown by the web app
# SIGNUP=open             # closed: only the first account (the admin) can sign up
ENV=DEV
