# Your iotstore on AWS. Copy to deploy.env (not committed), edit, then:
#   scripts/deploy.sh        the API: tables, bucket, function + URL (creates or updates)
#   scripts/deploy-web.sh    the web app
#
# One store = one set of these. Two stores (say, staging and production) in one account: two config
# files with different STORE_NAMEs, IOTSTORE_CONFIG=staging.env scripts/deploy.sh

# Prefix of everything it makes: tables <name>-users / -projects / -versions, function <name>-api
STORE_NAME=iotstore
# Names on AWS, when the defaults above do not suit (empty = from STORE_NAME):
#   the API's Lambda function (its role and layer are <function>-role, <function>-deps)
FUNCTION_NAME=
#   the tables' prefix: <prefix>users, <prefix>projects, <prefix>versions
TABLE_PREFIX=
# Shown in the web app (default: STORE_NAME)
STORE_TITLE=

# AWS account (profile from ~/.aws; empty = the default credentials) and region
AWS_PROFILE=
AWS_REGION=ap-southeast-1

# Package files. Bucket names are global: empty = <STORE_NAME>-packages-<account id>
S3_BUCKET_NAME=

# Other places the web app is served from, comma-separated (CORS of the API and the bucket); the
# WEB_BUCKET website is added by itself. Keep http://localhost:5310 to work on the web app locally.
WEB_ORIGIN=http://localhost:5310

# open: anyone can create a developer account. closed: only the first account (the admin).
SIGNUP=open

# Token signing key: empty = made on the first deploy and kept in the function's settings
JWT_SECRET_KEY=

# The web app's hosting (scripts/deploy-web.sh): an S3 bucket for frontend/dist (empty = build only).
WEB_BUCKET=
# website: deploy-web makes WEB_BUCKET a public S3 website (hosting on, read-only public policy, ACLs
#          off) and deploy adds its address to the API's CORS. private: files only (CloudFront etc.).
WEB_HOSTING=website
