.pio
.DS_Store

# pioarduino / ESP-IDF build output (regenerated from platformio.ini custom_sdkconfig)
.dummy/
managed_components/
dependencies.lock
sdkconfig.*
default_8MB.csv
compile_commands.json
*.d

# what the commands make inside app projects (the SDK's examples) and the font atlas cache
examples/*/build/
apps/*/build/
.build-cache/

# OS images, built apps and the simulator's card (tools/iotdash.py os build / app install)
os/build/

# desktop simulator builds (sim/build, sim/build-asan, ...)
sim/build/
sim/build-*/

# tools
tools/.venv/
tools/__pycache__/

# WiFi networks built into the system image (os/core/private/secrets.json): never committed
os/core/private/secrets.json

# WebAssembly build (web/build.sh): objects and the staged page files
web/build/
web/dist/

# OS / editor
Thumbs.db
*.swp
.idea/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# Python and Node anywhere (the store's own .gitignore has its specifics)
__pycache__/
*.pyc
.venv/
venv/
node_modules/
.vite/
*.tsbuildinfo
*.log

# secrets: Wi-Fi credentials, API keys, local settings
.env
.env.*
!.env.example
secrets.h
